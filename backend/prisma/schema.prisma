// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model SafePlace {
  id                  Int                  @id @default(autoincrement())
  name                String
  latitude            Float
  longitude           Float
  capacity            Int
  currentOccupants    Int                  @default(0)
  facilities          String               
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  supplies            SupplyDistribution[] 
}

model SupplyDistribution {
  id             Int       @id @default(autoincrement())
  safePlaceId    Int
  safePlace      SafePlace @relation(fields: [safePlaceId], references: [id], onDelete: Cascade)
  supplyType     String    
  distributionAt DateTime  
  quantity       String    
  description    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}